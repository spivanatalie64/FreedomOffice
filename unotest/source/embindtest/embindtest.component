<component
        environment="@CPPU_ENV@"
        loader="com.sun.star.loader.SharedLibrary"
        xmlns="http://openoffice.org/2010/uno-components">
    <implementation
            constructor="org_freedomoffice_comp_embindtest_BridgeTest_get_implementation"
            name="org.freedomoffice.comp.embindtest.BridgeTest">
        <singleton name="org.freedomoffice.embindtest.BridgeTest"/>
    </implementation>
    <implementation
            constructor="org_freedomoffice_comp_embindtest_Test_get_implementation"
            name="org.freedomoffice.comp.embindtest.Test">
        <service name="org.freedomoffice.embindtest.Test"/>
    </implementation>
    <implementation
            constructor="org_freedomoffice_comp_embindtest_Constructors_get_implementation"
            name="org.freedomoffice.comp.embindtest.Constructors">
        <service name="org.freedomoffice.embindtest.ImplicitConstructor"/>
        <service name="org.freedomoffice.embindtest.ExplicitConstructors"/>
    </implementation>
    <implementation
            constructor="org_freedomoffice_comp_embindtest_Singleton_get_implementation"
            name="org.freedomoffice.comp.embindtest.theSingleton"
            single-instance="true">
        <singleton name="org.freedomoffice.embindtest.theSingleton"/>
    </implementation>
</component>
