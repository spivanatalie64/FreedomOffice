{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "FreedomAI",
  "agent": {
    "FreedomAI": {
      "model": "ollama/llama3.2",
      "mode": "all",
      "description": "FreedomOffice's built-in AI assistant (100% local Ollama inference)",
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  },
  "skills": {
    "paths": [".opencode/skill"]
  },
  "mcpServers": {
    "freedom-search": {
      "command": "python3",
      "args": [".opencode/mcp_freedom_search.py"]
    }
  }
}
